# Optional local Vibe overrides. The setup script installs into .vibe/ by default.

# Use an already running vibe-server instead of spawning one.
# VIBE_SERVER_URL=http://127.0.0.1:3022

# Override the bundled server or model paths.
# VIBE_SERVER_PATH=
# VIBE_MODEL_PATH=

# Set to 1 to try the GPU backend. CPU is the default.
# VIBE_GPU=1

# Transcription language for the Whisper model.
# VIBE_LANGUAGE=en

# Upload limit in megabytes.
# MAX_UPLOAD_MB=500
